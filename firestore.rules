rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /users/{userId}/posts/{postId}
// Document ID: {postId} (matches post id)
//
// Fields:
//   - id: string (required, non-empty, max 128 chars, matches {postId}, immutable) - Unique post identifier
//   - visual_text: string (required, non-empty, max 2000 chars) - Question / visual text content
//   - read_more_content: string (required, max 10000 chars) - Long-form explanation and background
//   - answer: string (required, non-empty, max 2000 chars) - Solution / answer text
//   - category: string (required, non-empty, max 100 chars) - Category name
//   - style_hint: string (required, max 500 chars) - Visual styling guidance
//   - image_keyword: string (required, max 100 chars) - Search keyword for vector illustration
//   - text_length: string (required, allowed: 'short', 'medium', 'long') - Display format
//   - timestamp: number (required, positive integer/float in ms) - Creation time
//   - status: string (required, allowed: 'active', 'archived') - Post visibility/status
//   - userId: string (required, matches request.auth.uid and path {userId}, immutable) - Creator's UID
//   - imageUrl: string (optional, max 2048 chars) - Cached illustration URL
//   - renderedImageUrl: string (optional, max 2048 chars) - Public Firebase Storage URL for rendered card image
//   - scheduleStatus: string (optional, allowed: 'draft', 'queued', 'posted', 'failed') - Autopost status
//   - scheduledTime: string (optional, max 100 chars) - Scheduled time string (e.g. '09:00' or ISO)
//   - postedAt: number (optional, timestamp in ms) - Publication timestamp
//   - postedPlatforms: list (optional, list of strings, max 20 items) - Dispatched platforms
//   - postError: string (optional, max 2000 chars) - Error message if publication failed
//
// ---------------------------------------------------------------
//
// Collection: /users/{userId}/settings/{settingId}
// Document ID: {settingId} (required, non-empty string, max 64 chars, e.g. 'social')
//
// Fields (for 'social' setting):
//   - twitter: map (optional) - Twitter/X API credentials and toggles
//   - meta: map (optional) - Facebook/Instagram credentials and toggles
//   - tiktok: map (optional) - TikTok credentials and toggles
//   - scheduleTimes: list of strings (optional, max 20 items) - Preferred daily posting slots
//   - timezone: string (optional, max 100 chars) - User's local timezone
//   - autopostEnabled: bool (optional) - Automated posting toggle
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------------

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the resource path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that all required fields exist on the incoming payload
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that only defined fields exist on the incoming payload
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that specified immutable fields remain unchanged during update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ---------------------------------------------------------------
    // Domain Validator: QuizPost
    // ---------------------------------------------------------------

    function isValidQuizPost(data, userId, postId) {
      let requiredFields = [
        'id', 'visual_text', 'read_more_content', 'answer',
        'category', 'style_hint', 'image_keyword', 'text_length',
        'timestamp', 'status', 'userId'
      ];
      let allowedFields = [
        'id', 'visual_text', 'read_more_content', 'answer',
        'category', 'style_hint', 'image_keyword', 'text_length',
        'timestamp', 'status', 'userId', 'imageUrl',
        'renderedImageUrl', 'scheduleStatus', 'scheduledTime',
        'postedAt', 'postedPlatforms', 'postError'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        // id validation (must match document ID and be a valid string)
        data.id is string &&
        data.id == postId &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        // visual_text validation (must be non-empty string)
        data.visual_text is string &&
        data.visual_text.size() > 0 &&
        data.visual_text.size() <= 2000 &&
        // read_more_content validation
        data.read_more_content is string &&
        data.read_more_content.size() <= 10000 &&
        // answer validation (must be non-empty string)
        data.answer is string &&
        data.answer.size() > 0 &&
        data.answer.size() <= 2000 &&
        // category validation (must be non-empty string)
        data.category is string &&
        data.category.size() > 0 &&
        data.category.size() <= 100 &&
        // style_hint validation
        data.style_hint is string &&
        data.style_hint.size() <= 500 &&
        // image_keyword validation
        data.image_keyword is string &&
        data.image_keyword.size() <= 100 &&
        // text_length validation
        data.text_length is string &&
        data.text_length in ['short', 'medium', 'long'] &&
        // timestamp validation
        data.timestamp is number &&
        data.timestamp > 0 &&
        // status validation
        data.status is string &&
        data.status in ['active', 'archived'] &&
        // userId validation (must match authenticated UID and path parameter)
        data.userId is string &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        // optional imageUrl validation
        (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
        // optional renderedImageUrl validation
        (!('renderedImageUrl' in data) || data.renderedImageUrl == null || (data.renderedImageUrl is string && data.renderedImageUrl.size() <= 2048)) &&
        // optional scheduleStatus validation
        (!('scheduleStatus' in data) || data.scheduleStatus == null || (data.scheduleStatus is string && data.scheduleStatus in ['draft', 'queued', 'posted', 'failed'])) &&
        // optional scheduledTime validation
        (!('scheduledTime' in data) || data.scheduledTime == null || (data.scheduledTime is string && data.scheduledTime.size() <= 100)) &&
        // optional postedAt validation
        (!('postedAt' in data) || data.postedAt == null || (data.postedAt is number && data.postedAt > 0)) &&
        // optional postedPlatforms validation
        (!('postedPlatforms' in data) || data.postedPlatforms == null || (data.postedPlatforms is list && data.postedPlatforms.size() <= 20)) &&
        // optional postError validation
        (!('postError' in data) || data.postError == null || (data.postError is string && data.postError.size() <= 2000));
    }

    // ---------------------------------------------------------------
    // Domain Validator: User Settings
    // ---------------------------------------------------------------

    function isValidSettingId(settingId) {
      return settingId is string &&
        settingId.size() > 0 &&
        settingId.size() <= 64;
    }

    function isValidSetting(data, settingId) {
      return isValidSettingId(settingId) &&
        // Guard against resource exhaustion (max 50 top-level properties)
        data.keys().size() <= 50 &&
        (!('twitter' in data) || data.twitter is map) &&
        (!('meta' in data) || data.meta is map) &&
        (!('tiktok' in data) || data.tiktok is map) &&
        (!('scheduleTimes' in data) || (data.scheduleTimes is list && data.scheduleTimes.size() <= 20)) &&
        (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 100)) &&
        (!('autopostEnabled' in data) || data.autopostEnabled is bool);
    }

    // ---------------------------------------------------------------
    // Subcollection: /users/{userId}/posts/{postId}
    // ---------------------------------------------------------------

    match /users/{userId}/posts/{postId} {
      // Authenticated owners can read (get & list) their own posts
      allow read: if isOwner(userId);

      // Authenticated owners can create their own posts with valid schema
      allow create: if isOwner(userId) &&
        isValidQuizPost(request.resource.data, userId, postId);

      // Authenticated owners can update their own posts with valid schema and preserved immutable fields
      allow update: if isOwner(userId) &&
        isValidQuizPost(request.resource.data, userId, postId) &&
        areImmutableFieldsUnchanged(['id', 'userId']);

      // Authenticated owners can delete their own posts
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------
    // Subcollection: /users/{userId}/settings/{settingId}
    // ---------------------------------------------------------------

    match /users/{userId}/settings/{settingId} {
      // Authenticated owners can read (get & list) their own settings
      allow read: if isOwner(userId);

      // Authenticated owners can create their own settings with valid schema
      allow create: if isOwner(userId) &&
        isValidSetting(request.resource.data, settingId);

      // Authenticated owners can update their own settings with valid schema
      allow update: if isOwner(userId) &&
        isValidSetting(request.resource.data, settingId);

      // Authenticated owners can delete their own settings
      allow delete: if isOwner(userId) &&
        isValidSettingId(settingId);
    }

    // ---------------------------------------------------------------
    // Default Deny: All other collections and paths are closed
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
